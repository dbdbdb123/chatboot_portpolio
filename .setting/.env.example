OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:2b-q4_K_M
# C: 공간이 부족한 Windows 환경에서는 모델 저장소를 별도 드라이브로 지정합니다.
OLLAMA_MODELS=D:\Ollama\models
REQUEST_TIMEOUT_SECONDS=60
MAX_TOOL_ROUNDS=3

# One line of JSON. Only explicitly allow-listed tools are exposed to the model.
# MCP_SERVERS_JSON=[{"name":"docs","command":"uv","args":["run","my_mcp_server.py"],"allowed_tools":["search_docs"],"timeout_seconds":15}]
MCP_SERVERS_JSON=[]
